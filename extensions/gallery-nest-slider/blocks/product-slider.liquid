{%- comment -%}
  Merchant CSS from the theme editor.

  Deliberately OUTSIDE the root div below. `renderSlider` assigns `root.innerHTML`, which
  destroys every child of the root the moment the gallery initialises — a <style> in there
  would survive the theme editor's static preview and then silently disappear on the live
  page. Out here it also survives `replaceNativeGallery`, which relocates the root into the
  theme's own gallery container; CSS applies document-wide either way.

  The `replace` stops a stray `</style>` closing the tag early and letting the remainder be
  parsed as markup. That is defence against a malformed paste, not a security boundary:
  only staff who can already edit theme code reach this field.
{%- endcomment -%}
{%- if block.settings.custom_css != blank -%}
  <style>{{ block.settings.custom_css | replace: '</style', '' }}</style>
{%- endif -%}

<div
  class="gn-slider"
  data-gallery-nest-slider
  data-product-id="{{ product.id }}"
  data-app-proxy-path="/apps/gallery-nest/slider-settings"
  {%- comment -%}
    Empty when the merchant leaves this on "Use app setting", which is what lets the JS fall
    through to the shop-wide value. A non-empty default here would make every block override
    the app setting and the admin control would look broken.
  {%- endcomment -%}
  data-theme-profile="{{ block.settings.theme_profile }}"
  data-theme-selector="{{ block.settings.custom_gallery_selector | escape }}"
  data-has-only-default-variant="{{ product.has_only_default_variant }}"
  hidden
>
  {%- comment -%}
    Iterates product.media rather than product.images so videos appear in the gallery in
    the order the merchant arranged them in Shopify, interleaved with the photos.

    Two things are load-bearing here:

    - `emitted` tracks whether a comma is needed. `forloop.last` cannot be used, because
      media types this gallery does not render (3D models) are skipped mid-loop and would
      leave a trailing or doubled comma, breaking the whole JSON payload.
    - Image entries carry BOTH `id` and `imageId`. The app's `variantImageMap` and
      `imageCaptions` are keyed by the ProductImage id, which is what `product.images`
      used to emit; whichever of the two Liquid properties still yields that id, the
      slider's `mediaKeys` matches on either, so no saved mapping is stranded.

    `thumb`/`src`/`zoom` come from `preview_image` for every type, so a video's stills
    flow through the existing image plumbing untouched.
  {%- endcomment -%}
  <script type="application/json" data-gallery-nest-media>
    [
      {%- assign emitted = 0 -%}
      {%- for media in product.media -%}
        {%- assign kind = '' -%}
        {%- comment -%}
          Media still being processed has no preview image, and every URL below is derived
          from it — the same skip-if-not-ready rule the admin applies in `fromMedia`.
        {%- endcomment -%}
        {%- if media.preview_image != blank -%}
          {%- if media.media_type == 'image' -%}
            {%- assign kind = 'image' -%}
          {%- elsif media.media_type == 'video' -%}
            {%- assign kind = 'video' -%}
          {%- elsif media.media_type == 'external_video' -%}
            {%- assign kind = 'external_video' -%}
          {%- endif -%}
        {%- endif -%}

        {%- if kind != '' -%}
          {%- if emitted > 0 -%},{%- endif -%}
          {
            "id": {{ media.id | json }},
            "type": {{ kind | json }},
            "alt": {{ media.alt | default: product.title | json }},
            "thumb": {{ media.preview_image | image_url: width: 180 | json }},
            "src": {{ media.preview_image | image_url: width: 900 | json }},
            "zoom": {{ media.preview_image | image_url: width: 1800 | json }}

            {%- if kind == 'image' -%}
              , "imageId": {{ media.preview_image.id | json }},
              "variantIds": [
                {%- for variant in media.preview_image.variants -%}
                  {{ variant.id | json }}{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            {%- elsif kind == 'video' -%}
              {%- comment -%}
                Progressive MP4 only. A <source> list is resolved by "first one I can
                play", not "best one", so an HLS manifest ahead of the MP4s would strand
                every browser without native HLS.

                `height` travels with each source because Shopify returns them
                lowest-quality first, and "first playable" would then mean "worst" —
                the slider re-sorts on it. See `renderViewer`.
              {%- endcomment -%}
              , "sources": [
                {%- assign sourceCount = 0 -%}
                {%- for source in media.sources -%}
                  {%- if source.format == 'mp4' -%}
                    {%- if sourceCount > 0 -%},{%- endif -%}
                    {
                      "url": {{ source.url | json }},
                      "mimeType": {{ source.mime_type | json }},
                      "height": {{ source.height | default: 0 | json }}
                    }
                    {%- assign sourceCount = sourceCount | plus: 1 -%}
                  {%- endif -%}
                {%- endfor -%}
              ]
            {%- elsif kind == 'external_video' -%}
              {%- if media.host == 'youtube' -%}
                , "embedUrl": {{ media.external_id | prepend: 'https://www.youtube.com/embed/' | json }}
              {%- elsif media.host == 'vimeo' -%}
                , "embedUrl": {{ media.external_id | prepend: 'https://player.vimeo.com/video/' | json }}
              {%- endif -%}
            {%- endif -%}
          }
          {%- assign emitted = emitted | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  </script>
  <script type="application/json" data-gallery-nest-variants>
    [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "mediaId": {{ variant.featured_image.id | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  </script>
</div>

{% schema %}
{
  "name": "GalleryNest slider",
  "target": "section",
  "stylesheet": "gallery-nest-slider.css",
  "javascript": "gallery-nest-slider.js",
  "settings": [
    {
      "type": "select",
      "id": "theme_profile",
      "label": "Theme",
      "info": "Which theme's gallery markup to replace. Leave on \"Use app setting\" unless this theme needs something different.",
      "default": "",
      "options": [
        { "value": "", "label": "Use app setting" },
        { "value": "auto", "label": "Auto-detect" },
        { "value": "horizon", "label": "Horizon" },
        { "value": "dawn", "label": "Dawn (and Craft, Refresh, Sense, Studio, Taste)" },
        { "value": "impulse", "label": "Impulse" },
        { "value": "debut", "label": "Debut" },
        { "value": "prestige", "label": "Prestige" },
        { "value": "custom", "label": "Custom selector" }
      ]
    },
    {
      "type": "text",
      "id": "custom_gallery_selector",
      "label": "Custom gallery selector",
      "info": "Only used when Theme is \"Custom selector\". The CSS selector of your theme's product gallery container, e.g. .product__media-wrapper"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "Custom CSS",
      "info": "Applied to this product's gallery. Useful hooks: .gn-slider, .gn-slider__stage, .gn-slider__main, .gn-slider__thumb, .gn-slider__slide, .gn-slider__scroller, .gn-lightbox"
    }
  ]
}
{% endschema %}
