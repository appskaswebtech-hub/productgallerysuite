// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model ProductSliderSetting {
  id                String   @id @default(cuid())
  shop              String   @unique
  productIds        String   @default("[]")
  products          String   @default("[]")
  stageLayout          String  @default("single")
  carouselPerView      Int     @default(3)
  carouselNavigation   String  @default("arrows")
  thumbnailPosition String   @default("left")
  thumbnailSize     Int      @default(76)
  thumbnailShape       String  @default("square")
  thumbnailHoverEffect String  @default("none")
  syncVariantImages Boolean  @default(true)
  hideThumbnails    Boolean  @default(false)
  hideZoomIcon      Boolean  @default(false)
  zoomIconPosition  String   @default("top-right")
  previousArrowSvg  String   @default("")
  nextArrowSvg      String   @default("")
  zoomIconSvg       String   @default("")

  // App-level settings (managed from /app/settings)
  appEnabled          Boolean @default(true)
  defaultLocale       String  @default("en")
  zoomTrigger         String  @default("hover")
  zoomLevel           Int     @default(200)
  loopSlides          Boolean @default(true)
  keyboardNavigation  Boolean @default(true)
  replaceThemeGallery Boolean @default(true)
  lazyLoadImages      Boolean @default(true)
  accentColor         String  @default("#111111")
  hoverNavigation      Boolean @default(false)
  hoverNavigationSpeed Int     @default(1200)
  hoverNavigationAxis  String  @default("horizontal")
  hoverNavigationInvert Boolean @default(false)
  imageTransition      String  @default("fade")
  hoverTransition      String  @default("fade")
  transitionSpeed      Int     @default(300)
  // Which theme's gallery markup to target. "auto" keeps the historical selector
  // heuristic; customGallerySelector is only read when themeProfile is "custom".
  themeProfile          String  @default("auto")
  customGallerySelector String  @default("")

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ShopBilling {
  id             String   @id @default(cuid())
  shop           String   @unique
  plan           String   @default("STARTER")
  subscriptionId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// Aggregated gallery interactions, one row per shop + product + day + event type.
///
/// Deliberately holds no shopper identifier, session id, IP or precise timestamp. That
/// is what keeps it outside the scope of the customer redaction webhooks — adding any
/// per-shopper column would change that, and those handlers would need revisiting.
model GalleryStat {
  id        String   @id @default(cuid())
  shop      String
  productId String
  /// UTC YYYY-MM-DD. A string, so grouping by day needs no date functions on SQLite.
  day       String
  eventType String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@unique([shop, productId, day, eventType])
  @@index([shop, day])
}
